    "import pandas as pd\n",
    "f = pd.read_excel(\"C:/Users/acer/Income Chart.xlsx\")\n",
    "df\n",
    "df.head(12)\n",
    "df.tail(6)\n",
    "df.info()\n",
    "df.describe()\n",
    "df.isnull().sum()\n",
    "df.dtypes\n",
    "df = df.dropna( axis = 0)\n",
    "df.info()\n",
    "df\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "numeric_cols = ['Age', 'Annual Income ', 'Spending Score']\n",
    "import matplotlib.pyplot as plt\n",
    "df[numeric_cols].hist(bins=20, figsize=(10,6), color='skyblue', edgecolor='black')\n",
    "plt.suptitle('Histograms of Numerical Variables')\n",
    "plt.show()\n",
    "import matplotlib.pyplot as plt\n",
    "bar_chart = plt.bar('Gender','Annual Income ',color = 'skyblue',data = df )\n",
    "plt.show()\n",
    "sns.scatterplot(x ='Annual Income ', y = 'Spending Score' , data = df)\n",
    "plt.title('Income vs Spending Score by Gender')\n",
    "plt.show()\n",
    "sel_col = ['Annual Income ','Spending Score','Age']\n",
    "sel1= df[sel_col]\n",
    "correlation = sel1.corr()\n",
    "plt.figure(figsize=(5, 3))\n",
    "sns.heatmap(correlation, annot = True , cmap = 'coolwarm' , linewidth = 5, fmt = '.2f')\n",
    "plt.title('Heatmap of income and spending score')\n",
    "plt.show()\n",
    "sns.boxplot(x = 'Gender', y='Annual Income ' , data=df)\n",
    "plt.show()\n",
    "sns.boxplot(x = 'Gender', y='Spending Score' , data=df)\n",
    "plt.show()\n",
    "from scipy.stats import ttest_1samp\n",
    "df.describe()\n",
    "hm = 30\n",
    "t_stat,p_value = ttest_1samp(df['Spending Score'],hm)\n",
    "alpha = 0.05\n",
    "if p_value<alpha:\n",
    "    print(\"Reject Null Hypothesis\",\"P value\",p_value,\"Alpha Value\",alpha)\n",
    "else:\n",
    "    print(\"Failed to reject Null hypothesis\",\"P value\",p_value,\"Alpha Value\",alpha)\n",
    "df.describe()\n",
    "from scipy.stats import ttest_ind\n",
    "\n",
    "\n",
    "group1 = df[df[\"Gender\"]==\"Male\"][\"Spending Score\"]\n",
    "group2 = df[df[\"Gender\"]==\"Female\"][\"Spending Score\"]\n",
    "\n",
    "ttest_ind(group1, group2)\n",
    "\n",
    "print(\"T statistic:\", t_stat)\n",
    "print(\"P value:\", p_value)\n",
    "\n",
    "alpha=0.05\n",
    "\n",
    "if p_value<alpha:\n",
    "    print(\"Reject Null Hypothesis\",\"P value\",p_value,\"Alpha Value\",alpha)\n",
    "else:\n",
    "    print(\"Failed to reject Null hypothesis\",\"P value\",p_value,\"Alpha Value\",alpha)\n",
    "df.dtypes\n",
    "\n",
